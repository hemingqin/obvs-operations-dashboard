# Copy this file to .env for local Docker Compose runs.
# Replace all placeholder secrets before any real deployment.

APP_ENV=production
JWT_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRE_MINUTES=60

POSTGRES_DB=donations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-database-password@postgres:5432/donations

REDIS_URL=redis://redis:6379/0
DONATIONS_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Default production-style Compose serves the built frontend from Nginx on port 80.
NGINX_PORT=80
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=

# For Vite local development with docker-compose.dev.yml, use:
# VITE_API_BASE_URL=http://localhost/api
# VITE_WS_BASE_URL=ws://localhost
