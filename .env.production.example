# Copy this file to .env.production on the EC2 host.
# Never commit .env.production or real secrets.

APP_ENV=production

# Use a long random value generated outside git, for example:
# openssl rand -hex 32
JWT_SECRET=replace-with-long-random-production-secret
TOKEN_EXPIRE_MINUTES=60

POSTGRES_DB=donations
POSTGRES_USER=obvs_app
POSTGRES_PASSWORD=replace-with-strong-production-database-password
DATABASE_URL=postgresql+psycopg2://obvs_app:replace-with-strong-production-database-password@postgres:5432/donations

REDIS_URL=redis://redis:6379/0
DONATIONS_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Public Nginx entry points on EC2. Open only 80/443 in the security group.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Browser-facing routes. Keep these relative when Nginx serves frontend and API
# from the same domain.
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=

# Optional local image names used by docker-compose.prod.yml.
FRONTEND_IMAGE=obvs-frontend:prod
BACKEND_IMAGE=obvs-backend:prod

# EC2 notes:
# - Store the real .env.production only on the EC2 instance, or inject values
#   from GitHub/AWS secrets during provisioning.
# - Restrict file permissions, for example: chmod 600 .env.production
# - Do not print secrets in CI logs or commit this file with real values.
