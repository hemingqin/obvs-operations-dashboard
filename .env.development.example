# Copy this file to .env for local Docker Compose development.
# These values are intentionally local and must not be reused in production.

APP_ENV=development
JWT_SECRET=dev-only-secret-change-me
JWT_SECRET_KEY=dev-only-secret-change-me
TOKEN_EXPIRE_MINUTES=60

POSTGRES_DB=donations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/donations

REDIS_URL=redis://redis:6379/0
DONATIONS_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Production-style local Compose serves Nginx on localhost:80.
NGINX_PORT=80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=

# Vite development override values:
# VITE_API_BASE_URL=http://localhost/api
# VITE_WS_BASE_URL=ws://localhost

# Secret handling:
# - Local development can use disposable credentials.
# - EC2 must use unique secrets stored outside git in .env.production.
# - GitHub Actions should reference secrets such as EC2_HOST, EC2_USER, and
#   EC2_SSH_KEY without hard-coding values in workflow files.
